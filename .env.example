VITE_API_BASE_URL=http://localhost:3000

# Temporary: used by api/enquiry.ts to email enquiries directly while the
# backend isn't deployed. Set these in Vercel's project env vars for
# production, and here (or a local .env) for testing with `vercel dev`.
# Not prefixed with VITE_, so they stay server-side only.
# Same Brevo SMTP relay the backend already uses (mobpae-backend/.env).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_SECURE=false
MAIL_FROM=support@mobpae.com
MAIL_FROM_NAME=MobPae
ENQUIRY_TO_EMAIL=support@mobpae.com
